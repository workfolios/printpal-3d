  const removed = Array.from(a).filter((value) => !b.has(value));
  const output: string[] = [];
  if (added.length > 0)
    output.push(`${label} recorded only in Attempt B: ${added.join("; ")}.`);
  if (removed.length > 0)
    output.push(`${label} recorded only in Attempt A: ${removed.join("; ")}.`);
  return output;
}

function ensureComparableAttempt(attempt: Attempt, project: Project): void {
  if (attempt.projectId !== project.projectId)
    throw new Error("Both Attempts must belong to the selected Project.");
  if (!project.attemptIds.includes(attempt.attemptId))
    throw new Error(
      `Attempt ${attempt.attemptNumber} is not indexed by the selected Project.`,
    );
  if (!attempt.outcome)
    throw new Error(
      `Attempt ${attempt.attemptNumber} needs a recorded Outcome before comparison.`,
    );
  if (attempt.outcome.status === "NOT_YET_EVALUATED")
    throw new Error(
      `Attempt ${attempt.attemptNumber} must be evaluated before comparison.`,
    );
  if (attempt.status !== "OUTCOME_RECORDED" && attempt.status !== "COMPARED") {
    throw new Error(
      `Attempt ${attempt.attemptNumber} is not in a comparison-ready lifecycle state.`,
    );
  }
}

export function buildDeterministicComparison(
  project: Project,
  attemptA: Attempt,
  attemptB: Attempt,
  now = new Date().toISOString(),
  comparisonId: string = crypto.randomUUID(),
  projectAttempts: Attempt[] = [attemptA, attemptB],
): Comparison {
  if (attemptA.attemptId === attemptB.attemptId)
    throw new Error("A comparison requires two different Attempts.");
  ensureComparableAttempt(attemptA, project);
  ensureComparableAttempt(attemptB, project);

  const constants: FieldSnapshot[] = [];
  const changes: FieldChange[] = [];
  const missingInformation: string[] = [];
  const lineageEvidence = collectLineageEvidence(
    attemptA,
    attemptB,
    projectAttempts,
  );
  const declaredChanges = lineageEvidence.declaredChanges;
  const unknownChanges: string[] = [];

  for (const descriptor of FIELD_DESCRIPTORS) {
    const valueA = normalize(descriptor.value(attemptA));
    const valueB = normalize(descriptor.value(attemptB));
    if (valueA === undefined && valueB === undefined) {
      if (descriptor.importantWhenMissing)
        missingInformation.push(
          `${descriptor.label} is not recorded for either Attempt.`,
        );
      continue;
    }
    if (equalValues(valueA, valueB)) {
      constants.push({
        fieldPath: descriptor.fieldPath,
        label: descriptor.label,
        value: valueA as JsonValue,
      });
      continue;
    }
    changes.push({
      fieldPath: descriptor.fieldPath,
      label: descriptor.label,
      attemptAValue: valueA,
      attemptBValue: valueB,
    });
    if (
      descriptor.importantWhenMissing &&
      (valueA === undefined || valueB === undefined)
    ) {
      missingInformation.push(
        `${descriptor.label} is not recorded for ${valueA === undefined ? "Attempt A" : "Attempt B"}.`,
      );
    }
    if (
      !isExplainedChange(descriptor, declaredChanges, lineageEvidence.connected)
    ) {
      unknownChanges.push(
