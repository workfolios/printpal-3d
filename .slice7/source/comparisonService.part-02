    intentionalAliases: ["environment", "temperature", "humidity", "room"],
  },
  {
    fieldPath: "processContext.postProcessingPlan",
    label: "Post-Processing Plan",
    value: (a) => a.processContext.postProcessingPlan,
    intentionalAliases: [
      "post-processing",
      "postprocessing",
      "cure",
      "wash",
      "support",
    ],
  },
  {
    fieldPath: "sourceReferences",
    label: "Source References",
    value: (a) =>
      a.sourceReferences.map((source) => ({
        category: source.category,
        title: source.title,
        url: source.url,
        publisherOrOwner: source.publisherOrOwner,
        accessedAt: source.accessedAt,
        notes: source.notes,
        authorityClassification: source.authorityClassification,
      })),
    importantWhenMissing: true,
    intentionalAliases: ["source", "documentation", "guide"],
  },
];

function uniqueNonEmpty(values: string[]): string[] {
  return Array.from(
    new Set(values.map((value) => value.trim()).filter(Boolean)),
  );
}

function normalize(value: unknown): ComparableValue {
  if (value === undefined || value === null) return undefined;
  if (typeof value === "string") {
    const trimmed = value.trim();
    return trimmed ? trimmed : undefined;
  }
  if (typeof value === "number" || typeof value === "boolean") return value;
  if (Array.isArray(value)) {
    const normalized = value
      .map((item) => normalize(item))
      .filter((item): item is JsonValue => item !== undefined)
      .sort((a, b) => JSON.stringify(a).localeCompare(JSON.stringify(b)));
    return normalized.length > 0 ? normalized : undefined;
  }
  return JSON.parse(JSON.stringify(value)) as JsonValue;
}

function equalValues(a: ComparableValue, b: ComparableValue): boolean {
  return JSON.stringify(a) === JSON.stringify(b);
}

function formatValue(value: ComparableValue): string {
  if (value === undefined) return "not recorded";
  if (Array.isArray(value))
    return value.length > 0 ? value.map(String).join("; ") : "none recorded";
  if (typeof value === "object" && value !== null) return JSON.stringify(value);
  return String(value);
}

function tokenize(value: string): Set<string> {
  const stopWords = new Set([
    "from",
    "with",
    "this",
    "that",
    "then",
    "next",
    "attempt",
    "change",
    "changed",
    "planned",
    "using",
    "while",
    "other",
  ]);
  return new Set(
    value
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, " ")
      .split(/\s+/)
      .filter((token) => token.length >= 4 && !stopWords.has(token)),
  );
}

interface LineagePath {
  attempts: Attempt[];
  complete: boolean;
}

interface LineageEvidence {
  directParentChild: boolean;
  connected: boolean;
  complete: boolean;
  declaredChanges: string[];
}

function isExplainedChange(
  descriptor: FieldDescriptor,
  declaredChanges: string[],
  connectedLineage: boolean,
): boolean {
  if (
    connectedLineage &&
    declaredChanges.length > 0 &&
    (descriptor.fieldPath === "processContext.plannedAttemptDescription" ||
      descriptor.fieldPath === "processContext.plannedVariables")
  )
    return true;
  const evidence = tokenize(declaredChanges.join(" "));
