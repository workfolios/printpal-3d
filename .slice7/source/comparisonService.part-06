      "No recorded field or Outcome differences were identified across the governed comparison set.",
    );

  const uncertainties = [
    "This deterministic comparison identifies recorded similarities and differences; it does not establish causation.",
    "Unrecorded conditions, measurement variation, and interactions among variables may affect the observed Outcomes.",
  ];
  if (!lineageEvidence.connected) {
    uncertainties.push(
      lineageEvidence.complete
        ? "The selected Attempts do not share a recorded lineage; planned-change declarations were not treated as evidence between this pair."
        : "The recorded Attempt lineage is incomplete; planned-change declarations could not be evaluated completely between this pair.",
    );
  } else if (!lineageEvidence.directParentChild) {
    uncertainties.push(
      "The selected Attempts are not a direct parent-child pair. Planned-change declarations were aggregated only along their recorded lineage paths and remain declarations, not causal evidence.",
    );
  }
  if (missingInformation.length > 0)
    uncertainties.push(
      "Missing or unknown record fields limit the completeness of this comparison.",
    );

  return comparisonSchema.parse({
    comparisonId,
    projectId: project.projectId,
    schemaVersion: project.schemaVersion,
    attemptAId: attemptA.attemptId,
    attemptBId: attemptB.attemptId,
    constants,
    changes,
    intentionalChanges: declaredChanges,
    unknownChanges: uniqueNonEmpty(unknownChanges),
    missingInformation: uniqueNonEmpty(missingInformation),
    outcomeDifferences: uniqueNonEmpty(outcomeDifferences),
    supportedObservations: uniqueNonEmpty(supportedObservations),
    modelInferences: [],
    alternateExplanations: [],
    uncertainties,
    origin: "RULES_BASED_FALLBACK",
    promptVersion: DETERMINISTIC_COMPARISON_VERSION,
    createdAt: now,
  });
}

function comparedAttempt(
  attempt: Attempt,
  comparisonId: string,
  now: string,
): Attempt {
  if (attempt.status !== "OUTCOME_RECORDED" && attempt.status !== "COMPARED") {
    throw new Error(
      `Attempt ${attempt.attemptNumber} is not in a comparison-ready lifecycle state.`,
    );
  }
  if (
    attempt.status === "OUTCOME_RECORDED" &&
    !canTransitionAttemptStatus(attempt.status, "COMPARED")
  ) {
    throw new Error(
      `Invalid Attempt lifecycle transition: ${attempt.status} -> COMPARED`,
    );
  }
  return attemptSchema.parse({
    ...attempt,
    status: "COMPARED",
    comparisonIds: Array.from(
      new Set([...attempt.comparisonIds, comparisonId]),
    ),
    updatedAt: now,
  });
}

export async function createDeterministicComparisonInProject(
  database: PrintPalDatabase,
  projectId: string,
  attemptAId: string,
  attemptBId: string,
  now = new Date().toISOString(),
  comparisonId = crypto.randomUUID(),
): Promise<{
  comparison: Comparison;
  attemptA: Attempt;
  attemptB: Attempt;
  created: boolean;
}> {
  return database.transaction(
    "rw",
    database.projects,
    database.attempts,
    database.comparisons,
    database.nextTestPlans,
    async () => {
      const [
        project,
        attemptA,
        attemptB,
