        `${descriptor.label} changed without a matching declared planned-change reference.`,
      );
    }
  }

  if (attemptA.printerContext.unknownInformation)
    missingInformation.push(
      "Attempt A identifies unknown printer information.",
    );
  if (attemptB.printerContext.unknownInformation)
    missingInformation.push(
      "Attempt B identifies unknown printer information.",
    );
  if (attemptA.materialContext.unknownInformation)
    missingInformation.push(
      "Attempt A identifies unknown material information.",
    );
  if (attemptB.materialContext.unknownInformation)
    missingInformation.push(
      "Attempt B identifies unknown material information.",
    );

  const outcomeDifferences: string[] = [];
  const outcomeA = attemptA.outcome!;
  const outcomeB = attemptB.outcome!;
  if (outcomeA.status !== outcomeB.status)
    outcomeDifferences.push(
      `Outcome status changed from ${outcomeA.status} to ${outcomeB.status}.`,
    );

  const criteriaA = new Map(
    outcomeA.successCriteriaResults.map((result) => [result.criterion, result]),
  );
  const criteriaB = new Map(
    outcomeB.successCriteriaResults.map((result) => [result.criterion, result]),
  );
  for (const criterion of project.successCriteria) {
    const resultA = criteriaA.get(criterion);
    const resultB = criteriaB.get(criterion);
    if (!resultA || !resultB) {
      missingInformation.push(
        `Success-criterion result is incomplete for: ${criterion}.`,
      );
    } else {
      if (resultA.status !== resultB.status) {
        outcomeDifferences.push(
          `Criterion “${criterion}” changed from ${resultA.status} to ${resultB.status}.`,
        );
      }
      const noteA = resultA.notes?.trim() || "not recorded";
      const noteB = resultB.notes?.trim() || "not recorded";
      if (noteA !== noteB) {
        outcomeDifferences.push(
          `Criterion “${criterion}” note changed from “${noteA}” to “${noteB}”.`,
        );
      }
    }
  }
  if ((outcomeA.summary ?? "") !== (outcomeB.summary ?? ""))
    outcomeDifferences.push(
      "Observed-result summary text differs between the Attempts.",
    );
  outcomeDifferences.push(
    ...compareStringLists(
      "Deviation or defect",
      outcomeA.deviationsOrDefects,
      outcomeB.deviationsOrDefects,
    ),
  );
  outcomeDifferences.push(
    ...compareStringLists(
      "Unexpected condition",
      outcomeA.unexpectedConditions,
      outcomeB.unexpectedConditions,
    ),
  );
  outcomeDifferences.push(
    ...compareStringLists(
      "Post-processing step",
      outcomeA.postProcessingPerformed,
      outcomeB.postProcessingPerformed,
    ),
  );
  outcomeDifferences.push(
    ...compareStringLists(
      "Lesson",
      outcomeA.lessonsLearned,
      outcomeB.lessonsLearned,
    ),
  );

  const supportedObservations = [
    ...changes.map(
      (change) =>
        `${change.label}: Attempt A records “${formatValue(change.attemptAValue)}”; Attempt B records “${formatValue(change.attemptBValue)}”.`,
    ),
    ...outcomeDifferences,
  ];
  if (supportedObservations.length === 0)
    supportedObservations.push(
